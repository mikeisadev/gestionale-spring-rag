# Copia questo file in "docker/.env" e inserisci i tuoi valori.
# Il file .env NON va su git (contiene segreti).

# Chiave OpenAI per la chat (obbligatoria per il backend in Docker)
OPENAI_API_KEY=sk-...

# Credenziali MariaDB (se le cambi, aggiorna anche application.properties per lo sviluppo locale)
MARIADB_ROOT_PASSWORD=root123
MARIADB_USER=industriatech
MARIADB_PASSWORD=industriatech123
