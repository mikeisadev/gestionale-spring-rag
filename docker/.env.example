# Copia questo file in "docker/.env" e inserisci i tuoi valori.
# Il file .env NON va su git (contiene segreti).

# Chiave OpenAI per la chat (obbligatoria per il backend in Docker)
OPENAI_API_KEY=sk-...

# Credenziali MariaDB (se le cambi, aggiorna anche application.properties per lo sviluppo locale)
MARIADB_ROOT_PASSWORD=root123
MARIADB_USER=industriatech
MARIADB_PASSWORD=industriatech123

# n8n (lezione 6): chiave del webhook (Header Auth X-Api-Key) e token del server MCP
N8N_API_KEY=
N8N_MCP_TOKEN=


# Lezione 11: cartella del vault di Obsidian della LLM Wiki (montata in sola lettura nel backend).
# Vuota = wiki di esempio del progetto (llm-wiki-esempio). Usa lo stesso percorso del file .env di VS Code.
WIKI_VAULT_PATH=

# Lezione 13: il PRIMO amministratore, creato all'avvio solo se non ne esiste già uno.
# Password di almeno 12 caratteri. Dopo il primo avvio puoi togliere queste due righe.
# Non usare un'email già registrata come utente normale: per sicurezza non viene promossa.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
