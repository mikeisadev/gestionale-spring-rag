# Copia questo file in ".env" (nella cartella del progetto): VS Code lo legge all'avvio del backend
# (vedi "envFile" in .vscode/launch.json). Il file .env NON va su git.

# Lezione 11: cartella del vault di Obsidian della tua LLM Wiki (le pagine sono nella sottocartella "wiki").
# Se non hai ancora una wiki tua, usa quella di esempio del progetto:
#   WIKI_VAULT_PATH=/percorso/assoluto/gestionale-spring-rag/llm-wiki-esempio
# Lasciala vuota per disattivare la wiki.
WIKI_VAULT_PATH=

# Lezione 13: il PRIMO amministratore, creato all'avvio solo se non ne esiste già uno.
# Password di almeno 12 caratteri. Dopo il primo avvio puoi togliere queste due righe.
# Non usare un'email già registrata come utente normale: per sicurezza non viene promossa.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
